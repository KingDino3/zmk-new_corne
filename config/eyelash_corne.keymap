#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

/ {
    behaviors {
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };
    };

    rgb_encoder: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
&kp ESCAPE      &kp Q  &kp W    &kp E      &kp R        &kp T                           &kp UP                &kp Y    &kp U            &kp I          &kp O    &kp P     &kp HOME
&kp LEFT_SHIFT  &kp A  &lt 5 S  &lt 2 D    &lt 3 F      &kp G                 &kp LEFT  &kp ENTER  &kp RIGHT  &kp H    &lt 4 J          &lt 1 K        &lt 6 L  &kp SEMI  &kp END
&kp LEFT_WIN    &kp Z  &kp X    &kp C      &kp V        &kp B    &kp SPACE              &kp DOWN              &kp N    &kp M            &kp COMMA      &kp DOT  &kp FSLH  &kp ESC
                                &kp LCTRL  &lt 7 SPACE  &kp TAB                                               &kp ESC  &lt 2 BACKSPACE  &kp RIGHT_WIN
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        mouse {
            display-name = "NUMBER";
            bindings = <
&trans  &trans  &mmv MOVE_LEFT  &mmv MOVE_UP    &mmv MOVE_RIGHT  &msc SCRL_UP                                  &mmv MOVE_UP                     &trans  &trans     &trans  &trans     &trans     &trans
&trans  &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_DOWN                &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &trans  &mkp LCLK  &none   &mkp RCLK  &mkp MCLK  &trans
&trans  &trans  &trans          &trans          &trans           &trans          &kp C_MUTE                    &mmv MOVE_DOWN                   &trans  &trans     &trans  &trans     &trans     &trans
                                &trans          &trans           &trans                                                                         &trans  &trans     &trans
            >;

            sensor-bindings = <&scroll_encoder>;
            label = "mouse";
        };

        arrows {
            display-name = "SYMBOL";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                            &mmv MOVE_UP                     &kp PG_UP      &kp HOME  &kp UP_ARROW    &kp END    &kp INSERT  &trans
&trans  &trans  &trans  &trans  &trans  &trans            &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp PAGE_DOWN  &kp LEFT  &kp DOWN_ARROW  &kp RIGHT  &kp DEL     &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                    &mmv MOVE_DOWN                   &trans         &trans    &trans          &trans     &trans      &trans
                        &trans  &trans  &trans                                                             &trans         &trans    &trans
            >;

            sensor-bindings = <&scroll_encoder>;
            label = "arrows";
        };

        symbols {
            display-name = "Fn";
            bindings = <
&trans  &trans         &trans        &trans        &trans  &trans                                      &mmv MOVE_UP                     &kp EQUAL            &kp LS(UNDER)  &kp LS(PIPE)  &kp SQT      &trans      &trans
&trans  &kp LS(CARET)  &kp LS(STAR)  &kp LS(AMPS)  &none   &kp LS(AT)                  &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp LS(POUND)        &kp MINUS      &kp FSLH      &kp LS(DQT)  &kp DOLLAR  &trans
&trans  &trans         &trans        &trans        &trans  &trans        &kp C_MUTE                    &mmv MOVE_DOWN                   &kp LS(EXCLAMATION)  &kp LS(TILDE)  &kp BSLH      &kp GRAVE    &trans      &trans
                                     &trans        &trans  &kp C_VOL_DN                                                                 &kp C_VOLUME_UP      &trans         &trans
            >;

            sensor-bindings = <&scroll_encoder>;
            label = "symbols";
        };

        brackets {
            bindings = <
&trans  &kp GREATER_THAN  &kp RIGHT_BRACKET  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACE  &kp SEMICOLON                    &trans          &trans      &trans  &trans     &kp SINGLE_QUOTE  &trans       &trans
&trans  &kp LESS_THAN     &kp LEFT_BRACKET   &kp LEFT_PARENTHESIS   &kp LEFT_BRACE   &kp AT_SIGN              &trans  &trans  &trans  &kp HASH    &none   &kp EQUAL  &kp PLUS          &kp PERCENT  &trans
&trans  &trans            &kp EXCLAMATION    &kp COLON              &kp QUESTION     &kp HASH       &trans            &trans          &trans      &trans  &trans     &trans            &trans       &trans
                                             &trans                 &trans           &bl BL_INC                                       &bl BL_DEC  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            label = "brackets";
        };

        numbers {
            bindings = <
&trans  &trans  &trans  &trans     &trans     &trans                       &trans          &kp PLUS   &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_MULTIPLY  &trans
&trans  &trans  &none   &kp MINUS  &kp ASTRK  &kp ENTER            &trans  &trans  &trans  &kp MINUS  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_NUMBER_0  &trans
&trans  &trans  &trans  &trans     &trans     &trans     &trans            &trans          &kp EQUAL  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_DIVIDE    &trans
                        &trans     &trans     &trans                                       &trans     &trans           &trans
            >;

            label = "numpad";
        };

        FKeys {
            bindings = <
&trans  &trans  &kp F7  &kp F8  &kp F9  &kp F12                    &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp F4  &kp F5  &kp F6  &kp F11            &trans  &trans  &trans  &trans  &trans  &trans  &none   &trans  &trans
&trans  &trans  &kp F1  &kp F2  &kp F3  &kp F10  &trans            &trans          &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans                                     &trans  &trans  &trans
            >;

            label = "FKeys";
        };

        Space_Layer {
            bindings = <
&trans  &sys_reset  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &trans                             &rgb_ug RGB_ON                    &kp K_COPY   &kp ESCAPE       &kp COLON  &trans       &trans  &trans
&trans  &trans      &trans        &trans        &kp LEFT_WIN  &trans            &rgb_ug RGB_BRD  &rgb_ug RGB_EFF  &rgb_ug RGB_BRI  &kp K_PASTE  &kp ENTER        &kp SLASH  &kp PERCENT  &trans  &trans
&trans  &trans      &trans        &trans        &trans        &trans  &trans                     &rgb_ug RGB_OFF                   &kp K_CUT    &kp EXCLAMATION  &trans     &trans       &trans  &trans
                                  &trans        &none         &trans                                                               &trans       &trans           &trans
            >;

            sensor-bindings = <&rgb_encoder>;
            label = "Space";
        };
    };
};
